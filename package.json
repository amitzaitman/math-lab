{
  "name": "math-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "e2e": "playwright test",
    "verify": "npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "konva": "^10.0.0",
    "react-konva": "^19.2.0",
    "fraction.js": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.59.1",
    "vite-plugin-pwa": "^1.1.0"
  }
}
